# 仅监听本机，禁止把带 API Key 的代理暴露到公网。
BIGMODEL_PROXY_HOST=127.0.0.1
BIGMODEL_PROXY_PORT=8765
BIGMODEL_UPSTREAM_ORIGIN=https://open.bigmodel.cn

# 默认复刻 codex-nvidia-proxy/OpenAI SDK 的连接层：
# 共享 HTTP/1.1 客户端、keep-alive 连接池、继承系统代理、不转换 Responses 格式。
BIGMODEL_TRANSPORT_PROFILE=nvidia

# NVIDIA/OpenAI SDK 风格的预响应头连接重试。只在尚未收到 HTTP 响应头时执行，
# 每次都使用全新 TLS 连接；0=关闭。收到任何响应头或部分 SSE 后绝不重试。
BIGMODEL_PREHEADER_RETRIES=2
BIGMODEL_RETRY_BACKOFF=0.25

# 大请求默认在 90000 字节起改用 HTTP/1.1 chunked framing；JSON 字节不变。
# 可选：adaptive / content-length / chunked。
BIGMODEL_REQUEST_UPLOAD_MODE=adaptive
BIGMODEL_CHUNKED_THRESHOLD_BYTES=90000
BIGMODEL_UPLOAD_CHUNK_BYTES=8192

# 若要回到旧版“每请求新连接”诊断模式，改为 isolated。
# isolated 模式才读取下面四个细项；nvidia 模式会固定使用 HTTP/1.1 复用连接。
BIGMODEL_FORCE_HTTP1=1
BIGMODEL_CONNECTION_CLOSE=1
BIGMODEL_REUSE_UPSTREAM_CLIENT=0
BIGMODEL_FOLLOW_REDIRECTS=0

# 是否继承目标机的 HTTP_PROXY / HTTPS_PROXY / NO_PROXY。
BIGMODEL_TRUST_ENV_PROXY=1

# 超时（秒）。READ_TIMEOUT=0 表示无限等待，不建议在初次诊断时使用。
BIGMODEL_CONNECT_TIMEOUT=20
BIGMODEL_READ_TIMEOUT=600
BIGMODEL_WRITE_TIMEOUT=120
BIGMODEL_POOL_TIMEOUT=20

# 智谱静默期间，每隔多少秒向 Codex 发送一条本地 SSE 注释心跳；0=关闭。
BIGMODEL_LOCAL_HEARTBEAT=10

# 提前 EOF/读取异常时发送标准 response.failed，让 Codex 显示明确原因。
# 注意：是否继续重连仍由 Codex 的 stream_max_retries 决定。
BIGMODEL_SYNTHESIZE_FAILURE_EVENT=1

# 中文日志。默认绝不记录 Authorization/Cookie/对话正文。
BIGMODEL_LOG_LEVEL=INFO
BIGMODEL_LOG_BODY=0
BIGMODEL_LOG_BODY_MAX_CHARS=6000
BIGMODEL_LOG_MAX_MB=20
BIGMODEL_LOG_BACKUPS=8

# 企业 TLS 检查使用自定义 CA 时填写 PEM 文件完整路径。
BIGMODEL_CA_BUNDLE=
# 仅用于临时定位证书问题，正常使用严禁设为 1。
BIGMODEL_INSECURE_SKIP_VERIFY=0

# 启动时执行一次不带 API Key 的 DNS/TLS 快照。
BIGMODEL_STARTUP_PROBE=1
